    .scope S_0x5df8e28caa30;
T_0 ;
    %wait E_0x5df8e2892700;
    %load/vec4 v0x5df8e28cabc0_0;
    %inv;
    %store/vec4 v0x5df8e28deb30_0, 0, 1;
    %jmp T_0;
