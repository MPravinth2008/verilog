#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5f5be6da59e0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5f5be6da5b70 .scope module, "tb_nand_gate" "tb_nand_gate" 3 1;
 .timescale 0 0;
v0x5f5be6dbd6e0_0 .var "A", 0 0;
v0x5f5be6dbd780_0 .var "B", 0 0;
v0x5f5be6dbd840_0 .net "Y_BL", 0 0, v0x5f5be6dbca80_0;  1 drivers
v0x5f5be6dbd910_0 .net "Y_DFL", 0 0, L_0x5f5be6dbdc00;  1 drivers
v0x5f5be6dbd9e0_0 .net "Y_GL", 0 0, L_0x5f5be6dbdad0;  1 drivers
S_0x5f5be6da7a50 .scope module, "BL" "nand_gate_bl" 3 17, 4 1 0, S_0x5f5be6da5b70;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "A";
    .port_info 1 /INPUT 1 "B";
    .port_info 2 /OUTPUT 1 "Y";
v0x5f5be6da7c80_0 .net "A", 0 0, v0x5f5be6dbd6e0_0;  1 drivers
v0x5f5be6dbc9c0_0 .net "B", 0 0, v0x5f5be6dbd780_0;  1 drivers
v0x5f5be6dbca80_0 .var "Y", 0 0;
E_0x5f5be6da5f20 .event anyedge, v0x5f5be6da7c80_0, v0x5f5be6dbc9c0_0;
S_0x5f5be6dbcba0 .scope module, "DFL" "nand_gate_dfl" 3 13, 5 1 0, S_0x5f5be6da5b70;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "A";
    .port_info 1 /INPUT 1 "B";
    .port_info 2 /OUTPUT 1 "Y";
L_0x5f5be6dbdb90 .functor AND 1, v0x5f5be6dbd6e0_0, v0x5f5be6dbd780_0, C4<1>, C4<1>;
L_0x5f5be6dbdc00 .functor NOT 1, L_0x5f5be6dbdb90, C4<0>, C4<0>, C4<0>;
v0x5f5be6dbcdd0_0 .net "A", 0 0, v0x5f5be6dbd6e0_0;  alias, 1 drivers
v0x5f5be6dbcec0_0 .net "B", 0 0, v0x5f5be6dbd780_0;  alias, 1 drivers
v0x5f5be6dbcf90_0 .net "Y", 0 0, L_0x5f5be6dbdc00;  alias, 1 drivers
v0x5f5be6dbd060_0 .net *"_ivl_0", 0 0, L_0x5f5be6dbdb90;  1 drivers
S_0x5f5be6dbd180 .scope module, "GL" "nand_gate_gl" 3 9, 6 1 0, S_0x5f5be6da5b70;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "A";
    .port_info 1 /INPUT 1 "B";
    .port_info 2 /OUTPUT 1 "Y";
L_0x5f5be6dbdad0 .functor NAND 1, v0x5f5be6dbd6e0_0, v0x5f5be6dbd780_0, C4<1>, C4<1>;
v0x5f5be6dbd3e0_0 .net "A", 0 0, v0x5f5be6dbd6e0_0;  alias, 1 drivers
v0x5f5be6dbd4d0_0 .net "B", 0 0, v0x5f5be6dbd780_0;  alias, 1 drivers
v0x5f5be6dbd5e0_0 .net "Y", 0 0, L_0x5f5be6dbdad0;  alias, 1 drivers
    .scope S_0x5f5be6da7a50;
T_0 ;
    %wait E_0x5f5be6da5f20;
    %load/vec4 v0x5f5be6da7c80_0;
    %load/vec4 v0x5f5be6dbc9c0_0;
    %and;
    %inv;
    %store/vec4 v0x5f5be6dbca80_0, 0, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5f5be6da5b70;
T_1 ;
    %vpi_call/w 3 24 "$dumpfile", "nand_gate.vcd" {0 0 0};
    %vpi_call/w 3 25 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5f5be6da5b70 {0 0 0};
    %vpi_call/w 3 26 "$display", "A B | GL DFL BL" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f5be6dbd6e0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f5be6dbd780_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f5be6dbd6e0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f5be6dbd780_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f5be6dbd6e0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f5be6dbd780_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f5be6dbd6e0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f5be6dbd780_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 33 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x5f5be6da5b70;
T_2 ;
    %vpi_call/w 3 38 "$monitor", " %b %b | %b %b %b", v0x5f5be6dbd6e0_0, v0x5f5be6dbd780_0, v0x5f5be6dbd9e0_0, v0x5f5be6dbd910_0, v0x5f5be6dbd840_0 {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 7;
    "N/A";
    "<interactive>";
    "-";
    "tb_nand_gate.v";
    "nand_gate_bl.v";
    "nand_gate_dfl.v";
    "nand_gate_gl.v";
